# DeployMate AI - Environment Configuration Example
# Copy this file to .dev.vars for local overrides when running wrangler / vite dev

# Model override for Cloudflare Workers AI (defaults to @cf/meta/llama-3.3-70b-instruct-fp8-fast)
AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional: Cloudflare credentials for non-interactive / CI deployments
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
# CLOUDFLARE_API_TOKEN=your_api_token_here

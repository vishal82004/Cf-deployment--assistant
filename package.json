{
  "name": "deploymate-ai",
  "version": "1.0.0",
  "private": true,
  "description": "DeployMate AI - AI-powered developer deployment assistant built on Cloudflare Agents",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types env.d.ts",
    "check": "tsc --noEmit",
    "lint": "oxlint -D correctness -A no-unused-vars -A no-explicit-any src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:tools": "tsx scripts/test-tools-unit.ts",
    "test:llm": "tsx scripts/test-scenarios.ts",
    "test:memory": "tsx scripts/test-memory.ts",
    "test:planner": "tsx scripts/test-planner.ts",
    "test:policies": "tsx scripts/test-policies-unit.ts",
    "test:guardrails": "tsx scripts/test-guardrails-agent.ts",
    "test:workflow": "tsx scripts/test-workflow-unit.ts",
    "test:approval": "tsx scripts/test-approval-unit.ts"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.9.3",
    "@cloudflare/kumo": "^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "^0.17.4",
    "ai": "^6.0.197",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "workers-ai-provider": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.46.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.113.0"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
